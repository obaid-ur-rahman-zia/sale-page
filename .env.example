# Copy to .env and adjust for your environment.

# PostgreSQL connection string used by both the Next.js app and the Prisma CLI.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salepage?schema=public"

# IANA timezone used to turn the report date pickers into day boundaries.
APP_TIME_ZONE="Asia/Karachi"
NEXT_PUBLIC_APP_TIME_ZONE="Asia/Karachi"

# Optional: set a password to require sign-in on /admin. Leave unset to keep it open.
# ADMIN_USER="admin"
# ADMIN_PASSWORD=""
