# Copy to .env and adjust for your environment.

# MongoDB connection string used by both the Next.js app and the Prisma CLI.
# Must be a replica set (or Atlas) — Prisma cannot write to a standalone mongod.
# See README.md for the one-line docker command.
DATABASE_URL="mongodb://localhost:27018/salepage?directConnection=true"

# IANA timezone used to turn the report date pickers into day boundaries.
APP_TIME_ZONE="Asia/Karachi"
NEXT_PUBLIC_APP_TIME_ZONE="Asia/Karachi"

# Optional: set a password to put HTTP Basic auth in front of /admin and the
# category write endpoints. Leave unset to keep them open.
# ADMIN_USER="admin"
# ADMIN_PASSWORD=""
