// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // The Linux target used by the Dockerfile (node:20-bookworm-slim) has to be
  // generated alongside the local one.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int      @id @default(autoincrement())
  number    Int      @unique
  name      String
  imageUrl  String
  isActive  Boolean  @default(true)
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, number])
}

model Salesman {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id         Int       @id @default(autoincrement())
  saleId     String
  amount     Float
  discount   Float     @default(0)
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  salesmanId Int?
  salesman   Salesman? @relation(fields: [salesmanId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([saleId])
  @@index([salesmanId])
  @@index([categoryId, createdAt])
  @@index([createdAt])
}

model SaleBill {
  id            Int      @id @default(autoincrement())
  saleId        String   @unique
  totalDiscount Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
}
